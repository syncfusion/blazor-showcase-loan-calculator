<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

    <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
	<PackageReference Include="Blazored.LocalStorage" Version="4.4.0" />
	<PackageReference Include="Syncfusion.Blazor.Buttons" Version="34.1.29" />
	<PackageReference Include="Syncfusion.Blazor.Calendars" Version="34.1.29" />
	<PackageReference Include="Syncfusion.Blazor.Charts" Version="34.1.29" />
	<PackageReference Include="Syncfusion.Blazor.Core" Version="34.1.29" />
	<PackageReference Include="Syncfusion.Blazor.Grid" Version="34.1.29" />
	<PackageReference Include="Syncfusion.Blazor.Inputs" Version="34.1.29" />
	<PackageReference Include="Syncfusion.Blazor.Themes" Version="34.1.29" />
  </ItemGroup>

  <ItemGroup>
	<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>
</Project>
