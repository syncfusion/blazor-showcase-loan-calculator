@inject NavigationManager Urihelper

@* SEO Variables - Single source of truth for all meta tags *@
@{
    string SeoTitle = "Loan Calculator - Syncfusion Blazor Showcase";
    string SeoDescription = "Real-world loan calculation application demonstrating practical Syncfusion Blazor component integration.";
    string SiteUrl = Urihelper.Uri.TrimEnd('/');
    string ApplicationName = "Loan Calculator";
    string Publisher = "Syncfusion";
    string Language = "English";
    string SocialImage = SiteUrl + "/LoanCalculator.svg";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <!-- HTML Title -->
    <title>@SeoTitle</title>
    
    <!-- Primary Meta Tags -->
    <meta name="title" content="@SeoTitle" />
    <meta name="description" content="@SeoDescription" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="loan calculator, financial planning, mortgage, interest rates, calculations" />
    <meta name="publisher" content="@Publisher" />
    <meta name="language" content="@Language" />
    
    <!-- Canonical URL -->
    <link href="https://showcase.syncfusion.com/loan-calculator/blazor/wasm/" rel="canonical" />
    
    <!-- Alternate Language Tags -->
    <link rel="alternate" hreflang="en-US" href="@SiteUrl" />
    <link rel="alternate" hreflang="x-default" href="@SiteUrl" />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@SeoTitle" />
    <meta property="og:description" content="@SeoDescription" />
    <meta property="og:url" content="@SiteUrl" />
    <meta property="og:site_name" content="@ApplicationName" />
    <meta property="og:image" content="@SocialImage" />
    <meta property="og:image:alt" content="@ApplicationName Logo" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@SeoTitle" />
    <meta name="twitter:description" content="@SeoDescription" />
    <meta name="twitter:image" content="@SocialImage" />
    <meta name="twitter:image:alt" content="@ApplicationName" />
    <meta name="twitter:site" content="@@Syncfusion" />
    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />
    <!-- Google Tag Manager -->
    <!-- Load GTM-WXZ6DX9B immediately on page load  -->
    <script>
        (function (w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            }); var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-WXZ6DX9B');
    </script>
    <!-- Load GTM-W8WD8WN on user interaction -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const events = ["mousemove", "scroll", "keydown", "touchstart"];

            function loadGTM() {
                events.forEach(event => document.removeEventListener(event, loadGTM));
                (function (w, d, s, l, i) {
                    w[l] = w[l] || []; w[l].push({
                        'gtm.start':
                            new Date().getTime(), event: 'gtm.js'
                    }); var f = d.getElementsByTagName(s)[0],
                        j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                            'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
                })(window, document, 'script', 'dataLayer', 'GTM-W8WD8WN');
            }
            events.forEach(event => document.addEventListener(event, loadGTM, { once: true }));
        });
    </script>
    <ResourcePreloader />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <link rel="stylesheet" href="@Assets["css/bootstrap/bootstrap.min.css"]" />
    <ImportMap />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/IndexDark.css"]" />
    <link rel="stylesheet" href="@Assets["LoanCalculator.styles.css"]" />
    <link id="theme-link" href="@Assets["_content/Syncfusion.Blazor.Themes/fluent2.css"]" rel="stylesheet" />
    <link href="manifest.json" rel="manifest" />
    <link rel="apple-touch-icon" sizes="512x512" href="icon-512.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="icon-192.png" />
    
    <!-- Schema.org Structured Data - SoftwareApplication -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org/",
      "@@type": "SoftwareApplication",
      "name": "@ApplicationName",
      "description": "@SeoDescription",
      "url": "@SiteUrl",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "browserRequirements": "WebAssembly enabled browser",
      "image": "@SocialImage",
      "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@@type": "Organization",
        "name": "@Publisher",
        "url": "https://www.syncfusion.com"
      },
      "inLanguage": "en-US"
    }
    </script>
    
    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body class="light">
    <div id="app">
        <div class="loading-body-overlay">
            <div id="loader" class="loan-calculator-loading">
                <svg class="circular" height="40" width="40">
                    <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="6" stroke-miterlimit="10"></circle>
                </svg>
            </div>
            <div class="loading-caption">
                <h4 class="my-4" id="Loading-Text">Loading Loan Calculator...</h4>
            </div>
        </div>
    </div>

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
    <script>
        setTimeout(function () {
            var overlayEle = document.querySelector(".loading-body-overlay");
            if (overlayEle) {
                overlayEle.style.display = "none";
            }
        }, 4000);
    </script>
    <Routes @rendermode="InteractiveWebAssembly" />
    <!-- Google Tag Manager (noscript) -->
    <!--Page Load-->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WXZ6DX9B" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!--Interaction-->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W8WD8WN" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>navigator.serviceWorker.register('service-worker.js');</script>
    <script src="@Assets["_content/Syncfusion.Blazor.Core/scripts/syncfusion-blazor.min.js"]" type="text/javascript"></script>
    <script>


        function ChangeStyleSheet() {
            const body = document.getElementsByTagName('body');
            const link = document.getElementById('theme-link');
        const styleSheet = body[0].className == "light" ? 'fluent2' : 'fluent2-dark';
            link.setAttribute('href', `_content/Syncfusion.Blazor.Themes/${styleSheet}.css`);
        }

        function toggleTheme(theme) {
            var bodyElement = document.body
            if (bodyElement.classList.contains('light'))
                bodyElement.classList.remove('light');
            if (bodyElement.classList.contains('dark'))
                bodyElement.classList.remove('dark');
            var selectedTheme = theme === "Dark" ? "dark" : "light";
            bodyElement.classList.add(selectedTheme);
            ChangeStyleSheet();
        }

        function getViewportWidth() {
            return window.innerWidth;
        }

        function addResizeListener(dotNetObjectRef) {
            setTimeout(
                window.addEventListener('resize', function () {
                    dotNetObjectRef.invokeMethodAsync('OnWindowResized', window.innerWidth);
                }), 2000);
        }

    </script>
</body>

</html>
